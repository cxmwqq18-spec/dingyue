<style>.block__image {
  margin-bottom: 0.9375rem; }
  @media (min-width: 768px) {
    .block__image {
      margin-bottom: 1.25rem; } }

.block__title {
  font-size: 1.125rem;
  margin-bottom: 0.625rem; }

.block__text {
  font-size: 0.875rem;
  margin-bottom: 1.125rem; }

.block__btn {
  padding: 0.625rem 1.875rem;
  font-size: 0.875rem; }
</style>
<div class="lidl-story-strip">
<div class="container container-gap">
{% assign  title= section.settings.title %}
{% assign  align_text= section.settings.align_text %}
{% assign  blocks= section.blocks %}
{% assign display_title = title %}
{% if display_title == 'Text Columns With Images' %}
  {% assign display_title = 'Les incontournables de la semaine' %}
{% endif %}
{% if display_title != '' %}
  {% include 'card_title', title: display_title | escape %}
{% endif %}
<div class="row common__product-row {% if blocks.size == 1 %} justify-content-center {% endif %}">
  {%- assign flex_item_width = 'col-md-4' -%}
  {% case blocks.size %}
    {% when 1 %}
      {%- assign flex_item_width = 'col-md-6' -%}
    {% when 2 %}
      {%- assign flex_item_width = 'col-md-6' -%}
    {% when 4 %}
      {%- assign flex_item_width = 'col-md-6' -%}
  {% endcase %}
  {% for block in blocks %}
      {% if blocks.size == 5 and forloop.index < 3 %}
        {%- assign column_width = 'col-md-6' -%}
      {% else %}
        {%- assign column_width = flex_item_width -%}
      {% endif %}

{% assign defaultImage = '/themes/theme1/assets/image/44613f1sd54f.png' | img_url %}

<div class="block {{ column_width }} col-sm-12 text-{{ align_text }} common__product-gap">
  {% if block.settings.enable_image %}
    <div class="block__image">
      {% assign link_url = '' %}
      {% assign link_type = 'web' %}
      {% if block.settings.link.url != blank %}
        {% assign link_url = block.settings.link.url %}
        {% assign link_type = block.settings.link.type %}
      {% elsif block.settings.url != blank %}
        {% assign link_url = block.settings.url %}
      {% endif %}
      {% assign image = block.settings.image %}
      {% if image.src != blank %}
        <a class="lidl-story-strip__photo"
          {% if link_url != '' %}
            href="{{ link_url }}"
            data-track="viewImage"
            data-track-url="{{ link_url }}"
          {% endif %}
          {% unless link_type != 'web' or link_url contains shop.domain %}
            target="_blank"
          {% endunless %}
        >
          <img
            src="{{ shop.default_img }}"
            class="lazyload imglazy img-full-width"
            data-src="{{ image.src }}"
            alt="{{ block.settings.title | escape }}"
          >
        </a>
      {% elsif image != '' %}
        <a class="common__img-wrapper_lazy"
          {% if link_url != '' %}
            href="{{ link_url }}"
            data-track="viewImage"
            data-track-url="{{ link_url }}"
          {% endif %}
          {% unless link_type != 'web' or link_url contains shop.domain %}
            target="_blank"
          {% endunless %}
          style="width: 100%;">
          <img
            src="{{ shop.default_img }}"
            class="lazyload imglazy img-full-width{% if link_url %} common__img_hover{% endif %}"
            data-src="{{ image }}"
            alt="{{ block.settings.title | escape }}"
          >
        </a>
      {% else %}
        <img src="{{ defaultImage }}" alt="Feature column image"/>
      {% endif %}
    </div>
  {% endif %}
  {% if block.settings.title != '' %}
    <div class="block__title xf_skin_title_font">{{ block.settings.title | escape }}</div>
  {% endif %}
  {% if block.settings.text != '' %}
    <div class="block__text xf-mce-view xf_skin_text">{{ block.settings.text | replace: '\n', '<br>' | newline_to_br }}</div>
  {% endif %}
  {% assign button_link_url = '' %}
  {% assign button_link_type = 'web' %}
  {% if block.settings.button_link.url != blank %}
    {% assign button_link_url = block.settings.button_link.url %}
    {% assign button_link_type = block.settings.button_link.type %}
  {% elsif block.settings.button_link != blank %}
    {% assign button_link_url = block.settings.button_link %}
  {% endif %}
  {% if block.settings.button_label != '' and button_link_url != '' %}
    <a href="{{ button_link_url }}" class="btn btn-primary block__btn"
      {% unless button_link_type != 'web' or button_link_url contains shop.domain %}
        target="_blank"
      {% endunless %}
    >
      {{ block.settings.button_label | escape }}
    </a>
  {% endif %}
</div>

  {% endfor %}
</div>
</div>
</div>

{% schema %}
{
  "name": "feature_columns",
  "max_blocks": 9999,
  "settings": [
    {
      "type": "header",
      "content": {
        "en-US": "Settings",
        "zh-CN": "设置"
      }
    },
    {
      "type": "text",
      "id": "title",
      "label": {
        "en-US": "Heading",
        "zh-CN": "标题"
      },
      "placeholder": "",
      "default": "Text Columns With Images"
    },
    {
      "type": "select",
      "id": "align_text",
      "label": {
        "en-US": "Text alignment",
        "zh-CN": "文字对齐方式"
      },
      "options": [
        {
          "value": "left",
          "label": {
            "en-US": "Text left",
            "zh-CN": "居左"
          }
        },
        {
          "value": "center",
          "label": {
            "zh-CN": "居中",
            "en-US": "Text center"
          }
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": {
        "en-US": "Content",
        "zh-CN": "内容"
      }
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": {
        "zh-CN": "图文",
        "en-US": "Image with text"
      },
      "settings": [
        {
          "type": "checkbox",
          "id": "enable_image",
          "label": {
            "en-US": "Show images",
            "zh-CN": "图片是否展示"
          },
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": {
            "zh-CN": "添加图片",
            "en-US": "Add image"
          },
          "info": {
            "zh-CN": "建议尺寸：宽度800px,高度可自适应",
            "en-US": "Recommended resolution: width 800px,responsive height"
          },
          "default": ""
        },
        {
          "type": "url",
          "id": "link",
          "label": {
            "en-US": "Link",
            "zh-CN": "链接"
          },
          "default": ""
        },
        {
          "type": "text",
          "id": "title",
          "label": {
            "en-US": "Heading",
            "zh-CN": "标题"
          },
          "placeholder": "",
          "default": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": {
            "en-US": "Text",
            "zh-CN": "正文"
          },
          "default": "Use this text to describe products,share details on availability and style,or as a space to display recent reviews or FAQs."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": {
            "en-US": "Button text",
            "zh-CN": "按钮文字"
          },
          "default": ""
        },
        {
          "type": "url",
          "id": "button_link",
          "label": {
            "en-US": "Button link",
            "zh-CN": "按钮链接"
          },
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "feature_columns",
      "cname": {
        "zh-CN": "图文列表",
        "en-US": "Image with text list"
      },
      "category": {
        "en-US": "Material",
        "zh-CN": "素材"
      },
      "ccategory": {
        "en-US": "Material",
        "zh-CN": "素材"
      },
      "display": true,
      "blocks": [
        {
          "type": "text_block",
          "name": {
            "zh-CN": "图文",
            "en-US": "Image with text"
          },
          "settings": {
            "enable_image": true,
            "image": "",
            "url": "",
            "title": "Title",
            "text": "Use this text to describe products,share details on availability and style,or as a space to display recent reviews or FAQs.",
            "button_label": "",
            "button_link": ""
          }
        },
        {
          "type": "text_block",
          "name": {
            "zh-CN": "图文",
            "en-US": "Image with text"
          },
          "settings": {
            "enable_image": true,
            "image": "",
            "url": "",
            "title": "Title",
            "text": "Use this text to describe products,share details on availability and style,or as a space to display recent reviews or FAQs.",
            "button_label": "",
            "button_link": ""
          }
        },
        {
          "type": "text_block",
          "name": {
            "zh-CN": "图文",
            "en-US": "Image with text"
          },
          "settings": {
            "enable_image": true,
            "image": "",
            "url": "",
            "title": "Title",
            "text": "Use this text to describe products,share details on availability and style,or as a space to display recent reviews or FAQs.",
            "button_label": "",
            "button_link": ""
          }
        }
      ]
    }
  ]
}
