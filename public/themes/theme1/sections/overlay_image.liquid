{% assign image_src = section.settings.image_src.src | default: section.settings.image_src %}
{% assign title = section.settings.title %}
{% assign text = section.settings.text %}
{% assign url = section.settings.link_to_url.url %}
{% assign link_type = section.settings.link_to_url.type %}
{% assign button_label = section.settings.button_label %}
{% assign button_link = section.settings.button_link.url %}
{% assign button_link_type = section.settings.button_link.type %}
{% assign promo_link = button_link %}
{% assign promo_link_type = button_link_type %}
{% if promo_link == blank %}
  {% assign promo_link = url %}
  {% assign promo_link_type = link_type %}
{% endif %}
{% assign promo_title = title %}
{% assign promo_title_key = promo_title | downcase %}
{% if promo_title == blank or promo_title == 'Welcome to Lidl' or promo_title_key contains 'ffmmuu' or promo_title_key contains 'import' %}
  {% assign promo_title = 'Les offres de la semaine' %}
{% endif %}
{% assign promo_text = text %}
{% assign promo_text_key = promo_text | downcase %}
{% if promo_text == blank or promo_text contains 'Fresh products' or promo_text contains 'Fresh drops' or promo_text_key contains 'ffmmuu' or promo_text_key contains 'catalogue' or promo_text_key contains 'collect' or promo_text_key contains 'import' %}
  {% assign promo_text = 'Des nouveautés, des idées maison et des bons plans à découvrir chaque semaine.' %}
{% endif %}
{% assign promo_button_label = button_label %}
{% if promo_button_label == blank or promo_button_label == 'Discover More' %}
  {% assign promo_button_label = 'Voir les offres' %}
{% endif %}
{% assign promo_image_src = image_src %}
{% if promo_image_src == blank %}
  {% assign promo_image_src = '/themes/theme1/assets/image/generated/lidl/promo-weekly-deals.jpg' %}
{% endif %}
{% assign is_galina_editorial = false %}
{% if shop.id == '145' or shop.domain contains 'galinamcreations.com' %}
  {% assign is_galina_editorial = true %}
{% endif %}
{% if is_galina_editorial %}
  {% if promo_title == blank or promo_title == 'Image with text overlay' %}
    {% assign promo_title = 'Timeless Elegance' %}
  {% endif %}
  {% if promo_text == blank or promo_text contains 'Use overlay text' %}
    {% assign promo_text = 'Luxury silk shawls crafted with graceful drape, luminous detail and timeless sophistication for every occasion.' %}
  {% endif %}
  {% if promo_button_label == blank or promo_button_label == 'Voir les offres' %}
    {% assign promo_button_label = 'Shop Collection' %}
  {% endif %}
  {% if promo_link == blank %}
    {% assign promo_link = '/collections/home' %}
    {% assign promo_link_type = 'web' %}
  {% endif %}
  <style>
    .header_plus .menu-bg-color {
      background: rgba(255, 252, 249, 0.96);
      border-bottom: 1px solid rgba(34, 24, 20, 0.08);
      box-shadow: none;
    }
    .header_plus .header {
      min-height: 5.25rem;
    }
    .header_plus .header__logo img {
      max-width: 14.5rem;
      max-height: 4.25rem;
    }
    .header_plus .navigation-pc__menu-item_link,
    .header_plus .banner__color {
      letter-spacing: 0.08em;
    }
    .galina-editorial-hero {
      background:
        radial-gradient(circle at top left, rgba(255, 248, 243, 0.92), rgba(255, 248, 243, 0) 42%),
        linear-gradient(180deg, #fffdfa 0%, #fbf6f1 100%);
    }
    .galina-editorial-hero .container-gap {
      padding-top: 1.25rem;
      padding-bottom: 2.5rem;
    }
    .galina-editorial-hero__card {
      position: relative;
      min-height: 35rem;
      border-radius: 2rem;
      overflow: hidden;
      background: #eadfd4;
      box-shadow: 0 28px 70px rgba(55, 38, 28, 0.18);
      isolation: isolate;
    }
    .galina-editorial-hero__media {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(90deg, rgba(16, 11, 9, 0.82) 0%, rgba(16, 11, 9, 0.62) 32%, rgba(16, 11, 9, 0.08) 58%, rgba(16, 11, 9, 0) 74%),
        url('{{ promo_image_src }}');
      background-size: cover;
      background-position: center center;
      transform: scale(1.01);
    }
    .galina-editorial-hero__content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: flex-start;
      max-width: 31rem;
      min-height: 35rem;
      padding: 3.5rem 3.5rem 3rem;
      color: #fffaf6;
    }
    .galina-editorial-hero__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.7rem;
      margin-bottom: 1rem;
      color: #d7b08d;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.34em;
      text-transform: uppercase;
    }
    .galina-editorial-hero__eyebrow::after {
      content: '';
      width: 3.75rem;
      height: 1px;
      background: rgba(215, 176, 141, 0.7);
    }
    .galina-editorial-hero__title {
      margin: 0;
      font-family: "Baskerville", "Times New Roman", serif;
      font-size: clamp(3.2rem, 5vw, 4.9rem);
      line-height: 0.92;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: #fff8f3;
      text-shadow: 0 14px 36px rgba(0, 0, 0, 0.18);
    }
    .galina-editorial-hero__text {
      margin-top: 1.4rem;
      max-width: 25rem;
      color: rgba(255, 244, 237, 0.9);
      font-size: 1rem;
      line-height: 1.85;
    }
    .galina-editorial-hero__button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1.85rem;
      padding: 0.95rem 1.75rem;
      border-radius: 999px;
      background: linear-gradient(135deg, #c89a6d 0%, #a97853 100%);
      color: #fffaf6;
      font-size: 0.86rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      box-shadow: 0 18px 32px rgba(104, 66, 40, 0.24);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .galina-editorial-hero__button:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 38px rgba(104, 66, 40, 0.3);
      color: #fffaf6;
    }
    #xfcart-section-8042317530 .common-card-title,
    [data-section-id='8042317530'] .common-card-title {
      margin-bottom: 2.25rem !important;
      color: #231916;
      font-family: "Baskerville", "Times New Roman", serif;
      font-size: clamp(1.75rem, 3vw, 2.25rem);
      font-weight: 400;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    #xfcart-section-8042317530 .product-snippet,
    [data-section-id='8042317530'] .product-snippet {
      border-radius: 1.4rem;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 14px 34px rgba(58, 40, 29, 0.08);
    }
    #xfcart-section-8042317530 .product-snippet__img-wrapper,
    [data-section-id='8042317530'] .product-snippet__img-wrapper {
      background: linear-gradient(180deg, #fdf9f5 0%, #f5ebe2 100%);
    }
    @media (max-width: 767.98px) {
      .galina-editorial-hero .container-gap {
        padding-top: 0.6rem;
        padding-bottom: 1.5rem;
      }
      .galina-editorial-hero__card,
      .galina-editorial-hero__content {
        min-height: 33rem;
      }
      .galina-editorial-hero__media {
        background-position: 72% center;
      }
      .galina-editorial-hero__content {
        padding: 2rem 1.5rem 2.1rem;
        justify-content: flex-end;
        max-width: none;
      }
      .galina-editorial-hero__title {
        font-size: 2.55rem;
      }
      .galina-editorial-hero__text {
        font-size: 0.94rem;
        line-height: 1.7;
      }
      .galina-editorial-hero__button {
        width: 100%;
        letter-spacing: 0.12em;
      }
    }
  </style>
  <section class="galina-editorial-hero">
    <div class="container container-gap">
      <div class="galina-editorial-hero__card">
        <div class="galina-editorial-hero__media" role="img" aria-label="{{ promo_title | escape }}"></div>
        <div class="galina-editorial-hero__content">
          <span class="galina-editorial-hero__eyebrow">Galina Creations</span>
          <h1 class="galina-editorial-hero__title">{{ promo_title | escape }}</h1>
          <div class="galina-editorial-hero__text">{{ promo_text | newline_to_br }}</div>
          <a class="galina-editorial-hero__button"
            {% if promo_link != blank %}
              href="{{ promo_link }}"
            {% endif %}
            {% unless promo_link_type != 'web' or promo_link contains shop.domain %}
              target="_blank"
            {% endunless %}
          >{{ promo_button_label | escape }}</a>
        </div>
      </div>
    </div>
  </section>
{% else %}
  <div class="lidl-promo-banner">
    <div class="container container-gap">
      <a class="lidl-promo-banner__frame"
        {% if promo_link != blank %}
          href="{{ promo_link }}"
        {% endif %}
        {% unless promo_link_type != 'web' or promo_link contains shop.domain %}
          target="_blank"
        {% endunless %}
      >
        <div class="lidl-promo-banner__copy">
          <div class="lidl-promo-banner__sticker">
            <span class="lidl-promo-banner__eyebrow">Bons plans</span>
            <h2 class="lidl-promo-banner__title">{{ promo_title | escape }}</h2>
          </div>
          {% if promo_text != blank %}
            <div class="lidl-promo-banner__text">{{ promo_text | newline_to_br }}</div>
          {% endif %}
          <span class="btn btn-primary lidl-promo-banner__btn">{{ promo_button_label | escape }}</span>
        </div>
        <div class="lidl-promo-banner__visual">
          <img
            src="{{ shop.default_img }}"
            class="lazyload imglazy lidl-promo-banner__image"
            data-srcs="{{ promo_image_src }},{{ promo_image_src }}"
            data-sizes="auto"
            alt="{{ promo_title | escape }}"
          >
        </div>
      </a>
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "overlay_image",
  "settings": [
    {
      "type": "header",
      "content": {
        "en-US": "Edit image",
        "zh-CN": "编辑图片"
      }
    },
    {
      "type": "image_picker",
      "id": "image_src",
      "label": {
        "zh-CN": "选择图片",
        "en-US": "Add image"
      },
      "info": {
        "zh-CN": "建议尺寸（宽*高）：1920x667px,高度可自适应",
        "en-US": "Recommended resolution（ width * height）: 1920*667px, adaptive height"
      },
      "default": ""
    },
    {
      "type": "url",
      "id": "link_to_url",
      "label": {
        "en-US": "Image link",
        "zh-CN": "图片链接"
      },
      "default": ""
    },
    {
      "type": "range",
      "id": "opacity",
      "step": 1,
      "max": 100,
      "min": 0,
      "label": {
        "en-US": "Opacity",
        "zh-CN": "蒙层不透明度"
      },
      "default": 25,
      "unit": "%"
    },
    {
      "type": "color",
      "id": "overlay_bg_color",
      "label": {
        "en-US": "Overlay",
        "zh-CN": "蒙层颜色"
      },
      "default": "rgba(0, 0, 0, 1)"
    },
    {
      "type": "select",
      "id": "image_height",
      "label": {
        "zh-CN": "图片高度",
        "en-US": "Image height"
      },
      "default": "medium",
      "options": [
        {
          "label": {
            "en-US": "Natural",
            "zh-CN": "保留原尺寸"
          },
          "value": "origin"
        },
        {
          "label": {
            "zh-CN": "大",
            "en-US": "Large"
          },
          "value": "large"
        },
        {
          "label": {
            "zh-CN": "中",
            "en-US": "Medium"
          },
          "value": "medium"
        },
        {
          "label": {
            "zh-CN": "小",
            "en-US": "Small"
          },
          "value": "small"
        }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": {
        "zh-CN": "截取位置",
        "en-US": "Crop"
      },
      "default": "center",
      "options": [
        {
          "label": {
            "en-US": "Top",
            "zh-CN": "上"
          },
          "value": "top"
        },
        {
          "label": {
            "zh-CN": "中",
            "en-US": "Center"
          },
          "value": "center"
        },
        {
          "label": {
            "en-US": "Bottom",
            "zh-CN": "下"
          },
          "value": "bottom"
        }
      ]
    },
    {
      "type": "checkbox",
      "label": {
        "en-US": "Show below space",
        "zh-CN": "显示下间距"
      },
      "id": "is_bottom_margin_show",
      "default": false
    },
    {
      "type": "header",
      "content": {
        "en-US": "Edit text",
        "zh-CN": "编辑文案"
      }
    },
    {
      "type": "text",
      "id": "title",
      "label": {
        "en-US": "Heading",
        "zh-CN": "标题"
      },
      "default": "Image with text overlay"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": {
        "en-US": "Text",
        "zh-CN": "正文"
      },
      "default": "Use overlay text to give your customers insight into your brand. Select imagery and text that relates to your style and story"
    },
    {
      "type": "select",
      "id": "text_size",
      "label": {
        "zh-CN": "标题&正文大小",
        "en-US": "Heading and text size"
      },
      "default": "medium",
      "options": [
        {
          "label": {
            "zh-CN": "小",
            "en-US": "Small"
          },
          "value": "small"
        },
        {
          "label": {
            "zh-CN": "中",
            "en-US": "Medium"
          },
          "value": "medium"
        },
        {
          "label": {
            "zh-CN": "大",
            "en-US": "Large"
          },
          "value": "large"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_position",
      "label": {
        "en-US": "Text and button position",
        "zh-CN": "文字&按钮位置"
      },
      "default": "center",
      "options": [
        {
          "label": {
            "en-US": "Top & left",
            "zh-CN": "上左"
          },
          "value": "top_left"
        },
        {
          "label": {
            "en-US": "Top & center",
            "zh-CN": "上中"
          },
          "value": "top_center"
        },
        {
          "label": {
            "en-US": "Top & right",
            "zh-CN": "上右"
          },
          "value": "top_right"
        },
        {
          "label": {
            "en-US": "Center & left",
            "zh-CN": "中左"
          },
          "value": "center_left"
        },
        {
          "label": {
            "en-US": "Center",
            "zh-CN": "中"
          },
          "value": "center"
        },
        {
          "label": {
            "en-US": "Center & right",
            "zh-CN": "中右"
          },
          "value": "center_right"
        },
        {
          "label": {
            "en-US": "Bottom & left",
            "zh-CN": "下左"
          },
          "value": "bottom_left"
        },
        {
          "label": {
            "en-US": "Bottom & center",
            "zh-CN": "下中"
          },
          "value": "bottom_center"
        },
        {
          "label": {
            "en-US": "Bottom & right",
            "zh-CN": "下右"
          },
          "value": "bottom_right"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_justify",
      "label": {
        "en-US": "Text alignment",
        "zh-CN": "文字对齐方式"
      },
      "default": "center",
      "options": [
        {
          "label": {
            "en-US": "Text left",
            "zh-CN": "居左"
          },
          "value": "left"
        },
        {
          "label": {
            "zh-CN": "居中",
            "en-US": "Text center"
          },
          "value": "center"
        },
        {
          "label": {
            "en-US": "Text right",
            "zh-CN": "居右"
          },
          "value": "right"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": {
        "en-US": "Text color",
        "zh-CN": "文字颜色"
      },
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": {
        "en-US": "Edit button",
        "zh-CN": "编辑按钮"
      }
    },
    {
      "type": "text",
      "id": "button_label",
      "label": {
        "zh-CN": "按钮名称",
        "en-US": "Button text"
      },
      "default": ""
    },
    {
      "type": "url",
      "id": "button_link",
      "label": {
        "en-US": "Button link",
        "zh-CN": "按钮链接"
      },
      "default": ""
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": {
        "en-US": "Button background color",
        "zh-CN": "按钮背景颜色"
      },
      "default": "rgba(255, 255, 255, 1)"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": {
        "en-US": "Button text color",
        "zh-CN": "按钮文字颜色"
      },
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "overlay_image",
      "cname": {
        "en-US": "Single image",
        "zh-CN": "单图片"
      },
      "category": {
        "en-US": "Material",
        "zh-CN": "素材"
      },
      "ccategory": {
        "en-US": "Material",
        "zh-CN": "素材"
      },
      "display": true,
      "blocks": []
    }
  ]
}
{% endschema %}
