<style>.newsletter__input {
  height: 2.75rem;
  font-size: 0.875rem; }

.newsletter__btn {
  margin-top: 0.9375rem;
  width: 10.625rem;
  height: 2.75rem;
  font-size: 1rem; }

.newsletter__title {
  font-size: 1.4375rem;
  line-height: 1.2em; }
  .newsletter__title_sub {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.2em;
    color: #777; }
    .newsletter__title_sub + .newsletter__form {
      margin-top: 2.5rem; }
  .newsletter__title + .newsletter__form {
    margin-top: 2.5rem; }

.newsletter_subscribed {
  display: none; }

.newsletter_subscribing {
  display: block; }

.newsletter_success .newsletter_subscribing {
  display: none; }

.newsletter_success .newsletter_subscribed {
  display: block; }

@media (min-width: 768px) {
  .newsletter__title {
    font-size: 2.125rem; }
    .newsletter__title_sub {
      font-size: 1rem;
      line-height: 1.5em; }
  .newsletter__input {
    width: 21.25rem;
    margin-bottom: 0; }
  .newsletter__input-wrap {
    max-width: 21.875rem; }
  .newsletter__btn {
    margin-top: 0;
    margin-left: 0.375rem;
    width: 10.625rem; }
  .newsletter__btn-wrap {
    max-width: 11.625rem;
    text-align: left; }
  .form-row {
    max-width: 33.5rem; } }
</style>
{% assign is_whiteribbon_boutique = false %}
{% if shop.id == '144' or shop.domain contains 'whiteribbonboutiques.com' %}
  {% assign is_whiteribbon_boutique = true %}
{% endif %}
{% if is_whiteribbon_boutique %}
<style>
  #xfcart-section-{{section.id}} .whiteribbon-newsletter {
    background: linear-gradient(180deg, #fff8f6 0%, #fef1ee 100%);
    border-top: 1px solid rgba(34, 24, 24, 0.08);
    border-bottom: 1px solid rgba(34, 24, 24, 0.08);
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter__card {
    padding: 40px 0;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter__eyebrow {
    color: #8f6d72;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 28px;
    align-items: center;
    margin-top: 14px;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .newsletter__title {
    color: #1f1718;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.08;
    text-align: left;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .newsletter__title_sub {
    margin-top: 12px;
    color: #5f5357;
    font-size: 1rem;
    line-height: 1.75;
    text-align: left;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .newsletter__form {
    margin-top: 0;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .form-row {
    max-width: none;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .newsletter__input {
    width: 100%;
    height: 54px;
    border: 1px solid rgba(34, 24, 24, 0.12);
    border-radius: 0;
    background: #fff;
    font-size: 0.95rem;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .newsletter__input-wrap {
    max-width: none;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .newsletter__btn-wrap {
    max-width: 170px;
  }
  #xfcart-section-{{section.id}} .whiteribbon-newsletter .newsletter__btn {
