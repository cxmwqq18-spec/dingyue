{% assign is_galina_editorial = false %}
{% if shop.id == '145' or shop.domain contains 'galinamcreations.com' %}
  {% assign is_galina_editorial = true %}
{% endif %}
{% if is_galina_editorial %}
  {% assign story_image = section.settings.image_src_1.src | default: section.settings.image_src_1 %}
  <style>
    .galina-values {
      background: linear-gradient(180deg, #fffdfa 0%, #fcf7f2 100%);
    }
    .galina-values__heading,
    .galina-story__title,
    .galina-voices__heading {
      color: #231916;
      font-family: "Baskerville", "Times New Roman", serif;
      font-weight: 400;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }
    .galina-values__heading,
    .galina-voices__heading {
      margin: 0 0 2.35rem;
      text-align: center;
      font-size: clamp(1.75rem, 3vw, 2.25rem);
    }
    .galina-values__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
    }
    .galina-values__item {
      padding: 2rem 1.5rem 1.75rem;
      border: 1px solid rgba(184, 142, 108, 0.22);
      border-radius: 1.5rem;
      background: rgba(255, 255, 255, 0.84);
      text-align: center;
      box-shadow: 0 18px 40px rgba(76, 52, 34, 0.06);
    }
    .galina-values__badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3rem;
      height: 3rem;
      margin-bottom: 1rem;
      border-radius: 999px;
      background: linear-gradient(135deg, #d7b08d 0%, #b48763 100%);
      color: #fffaf6;
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.16em;
    }
    .galina-values__title {
      margin: 0;
      color: #2d211b;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .galina-values__text {
      margin-top: 0.85rem;
      color: #70584a;
      font-size: 0.96rem;
      line-height: 1.7;
    }
    .galina-story {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 2.5rem;
      margin-top: 4rem;
      align-items: center;
    }
    .galina-story__figure {
      position: relative;
      border-radius: 2rem;
      overflow: hidden;
      min-height: 100%;
      box-shadow: 0 24px 54px rgba(58, 40, 29, 0.16);
    }
    .galina-story__figure::after {
      position: absolute;
      inset: auto 1.5rem 1.5rem auto;
      width: 6rem;
      height: 6rem;
      border: 1px solid rgba(255, 248, 242, 0.45);
      border-radius: 50%;
      content: '';
    }
    .galina-story__figure img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .galina-story__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.65rem;
      color: #b48763;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }
    .galina-story__eyebrow::after {
      content: '';
      width: 3.5rem;
      height: 1px;
      background: rgba(180, 135, 99, 0.6);
    }
    .galina-story__title {
      margin: 1rem 0 0;
      font-size: clamp(2rem, 3.6vw, 3rem);
      line-height: 1.08;
      letter-spacing: 0.02em;
      text-transform: none;
    }
    .galina-story__text {
      margin-top: 1.25rem;
      color: #5f4a3d;
      font-size: 1rem;
      line-height: 1.9;
    }
    .galina-story__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 1.6rem;
      padding: 0.95rem 1.7rem;
      border-radius: 999px;
      background: linear-gradient(135deg, #c89a6d 0%, #a97853 100%);
      color: #fffaf6;
      font-size: 0.84rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      text-decoration: none;
      box-shadow: 0 18px 32px rgba(104, 66, 40, 0.18);
    }
    .galina-story__cta:hover,
    .galina-story__cta:focus {
      color: #fffaf6;
      background: linear-gradient(135deg, #cfa47a 0%, #b1815d 100%);
    }
    .galina-voices {
      margin-top: 4rem;
    }
    .galina-voices__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
    .galina-quote {
      padding: 1.75rem 1.5rem;
      border: 1px solid rgba(184, 142, 108, 0.18);
      border-radius: 1.5rem;
      background: #fff;
      box-shadow: 0 18px 36px rgba(76, 52, 34, 0.05);
    }
    .galina-quote__text {
      color: #4f3d33;
      font-size: 0.98rem;
      line-height: 1.8;
    }
    .galina-quote__meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 1.35rem;
      color: #231916;
      font-size: 0.92rem;
      font-weight: 700;
    }
    .galina-quote__stars {
      color: #c89a6d;
      letter-spacing: 0.12em;
      white-space: nowrap;
    }
    @media (max-width: 991.98px) {
      .galina-values__list,
      .galina-voices__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .galina-story {
        grid-template-columns: 1fr;
      }
    }
    @media (max-width: 767.98px) {
      .galina-values__list,
      .galina-voices__grid {
        grid-template-columns: 1fr;
      }
      .galina-values__item,
      .galina-quote {
        padding: 1.5rem 1.2rem;
      }
      .galina-story {
        margin-top: 2.75rem;
        gap: 1.5rem;
      }
      .galina-story__title {
        font-size: 1.85rem;
      }
      .galina-voices {
        margin-top: 2.75rem;
      }
    }
  </style>
  <section class="galina-values">
    <div class="container container-gap">
      <h2 class="galina-values__heading">Why Choose Galina Creations</h2>
      <div class="galina-values__list">
        <article class="galina-values__item">
          <span class="galina-values__badge">01</span>
          <h3 class="galina-values__title">Premium Textures</h3>
          <p class="galina-values__text">Lightweight drape, elegant movement and refined finishes chosen for everyday luxury.</p>
        </article>
        <article class="galina-values__item">
          <span class="galina-values__badge">02</span>
          <h3 class="galina-values__title">Artful Color</h3>
          <p class="galina-values__text">Rich contrast palettes designed to elevate black, neutrals and occasion dressing with ease.</p>
        </article>
        <article class="galina-values__item">
          <span class="galina-values__badge">03</span>
          <h3 class="galina-values__title">Versatile Styling</h3>
          <p class="galina-values__text">From ceremony looks to polished daily wear, each shawl is designed to adapt beautifully.</p>
        </article>
        <article class="galina-values__item">
          <span class="galina-values__badge">04</span>
          <h3 class="galina-values__title">Secure Delivery</h3>
          <p class="galina-values__text">Careful order handling, dependable checkout and thoughtful service from order to arrival.</p>
        </article>
      </div>

      <div class="galina-story">
        <a class="galina-story__figure" href="/collections/home">
          <img
            src="{{ story_image }}"
            alt="Galina Creations editorial portrait"
          >
        </a>
        <div class="galina-story__copy">
          <span class="galina-story__eyebrow">Our Story</span>
          <h3 class="galina-story__title">Inspired by Elegance, Made for You</h3>
          <div class="galina-story__text">
            Galina Creations celebrates fluid silhouettes, luminous fabric and quiet confidence. Our collection is curated for women who want statement pieces that still feel graceful, wearable and timeless.
          </div>
          <div class="galina-story__text">
            Every shawl is selected for movement, texture and versatility, so each piece feels as beautiful at an event as it does in everyday styling.
          </div>
          <a class="galina-story__cta" href="/pages/contact-us">Learn More About Us</a>
        </div>
      </div>

      <div class="galina-voices">
        <h2 class="galina-voices__heading">What Our Customers Say</h2>
        <div class="galina-voices__grid">
          <article class="galina-quote">
            <div class="galina-quote__text">"The fabric feels incredibly soft and the drape is even more elegant in person. It instantly made my outfit feel complete."</div>
            <div class="galina-quote__meta">
              <span>Sophia M.</span>
              <span class="galina-quote__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </div>
          </article>
          <article class="galina-quote">
            <div class="galina-quote__text">"Beautiful finish, rich color and very flattering movement. It feels like a boutique piece rather than a standard accessory."</div>
            <div class="galina-quote__meta">
              <span>Emma L.</span>
              <span class="galina-quote__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </div>
          </article>
          <article class="galina-quote">
            <div class="galina-quote__text">"The delivery was smooth and the shawl arrived beautifully packaged. It looks polished enough for gifting as well."</div>
            <div class="galina-quote__meta">
              <span>Olivia R.</span>
              <span class="galina-quote__stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>
{% else %}
  <style>.three-image__image {
    margin-bottom: 0.9375rem; }
    .three-image__image:last-child {
      margin-bottom: 0; }

  @media (min-width: 768px) {
    .three-image__row {
      margin: 0 -1.6875rem; }
    .three-image__image {
      padding: 0 0.75rem;
      margin-bottom: 0; } }
  </style>
  <div class="container container-gap">
    {% assign  text= section.settings.text %}
  <div class="row three-image__row">
  {% assign defaultImg = '/themes/theme1/assets/image/img2.png' %}
  {% for i in (1..3) %}
    {% assign image_src = 'image_src_' | append: i %}
    {% assign link_url = 'url_' | append: i %}
    {% assign imageUrl = section.settings[image_src] %}
    {% assign linkToUrl = section.settings[link_url].url %}
    {% assign link_type = section.settings[link_url].type %}
    <div class="col-sm-12 col-md-4 three-image__image">
      <a class="common__img-wrapper_lazy {% if linkToUrl %}common__mask{% endif %} {%if shop.env == 1 and imageUrl == "" %}common__img-desc{% endif %}" data-title="Image-{{i}}"
        style="padding-bottom:{{ imageUrl.height | image_padding_bottom : imageUrl.width, origin: 'unlimit'}}; width:100%"
        {% if linkToUrl%}
          href="{{ linkToUrl }}"
        {% endif %}
        {% if link_type == 'web' %}
          target="_blank"
        {% endif %}>
        {% assign src = imageUrl.src | default: defaultImg %}
        {% include 'lazyimg', src: src, class: 'img-full-width' %}
      </a>
    </div>
  {% endfor %}
  </div>
  </div>
{% endif %}



