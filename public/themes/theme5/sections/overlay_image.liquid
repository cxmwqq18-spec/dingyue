{% comment %} color_to_hex: Converts a CSS color string to hex6 format. {% endcomment %}
{% assign image_height = section.settings.image_height %}
{% assign text_size = section.settings.text_size %}
{% assign image_src = section.settings.image_src %}
{% assign opacity = section.settings.opacity | divided_by: 100.0 %}
{% assign alignment = section.settings.alignment %}
{% assign title = section.settings.title %}
{% assign text = section.settings.text %}
{% assign url = section.settings.link_to_url.url %}
{% assign link_type = section.settings.link_to_url.type %}
{% assign button_label = section.settings.button_label %}
{% assign button_link = section.settings.button_link.url %}
{% assign button_link_type = section.settings.button_link.type %}
{% assign text_position = section.settings.text_position %}
{% assign text_color = section.settings.text_color %}
{% assign text_justify = section.settings.text_justify %}
{% assign is_bottom_margin_show = section.settings.is_bottom_margin_show %}
{% assign overlay_bg_color = section.settings.overlay_bg_color | color_to_hex %}
{% assign button_bg_color = section.settings.button_bg_color | color_to_hex %}
{% assign button_text_color = section.settings.button_text_color %}
{% assign is_galina_editorial = false %}
{% if shop.id == '145' or shop.domain contains 'galinamcreations.com' %}
  {% assign is_galina_editorial = true %}
  {% assign text_position = 'center_left' %}
  {% assign text_justify = 'left' %}
  {% if title == blank or title == 'Image with text overlay' %}
    {% assign title = 'Timeless Elegance' %}
  {% endif %}
  {% if text == blank or text contains 'Use overlay text' %}
    {% assign text = 'Luxury silk shawls crafted with graceful drape, luminous detail and timeless sophistication for every occasion.' %}
  {% endif %}
  {% if button_label == blank %}
    {% assign button_label = 'Shop Collection' %}
  {% endif %}
  {% if button_link == blank %}
    {% assign button_link = '/collections/home' %}
    {% assign button_link_type = '' %}
  {% endif %}
  {% assign button_bg_color = '#b48763' %}
  {% assign button_text_color = '#fff8f2' %}
{% endif %}

{% if image_height == "large" %}
  {% assign mobile_height = "460px" %}
  {% assign pc_height = "600px" %}
{% elsif image_height == "medium" %}
  {% assign mobile_height = "400px" %}
  {% assign pc_height = "500px" %}
{% elsif image_height == "small" %}
  {% assign mobile_height = "300px" %}
  {% assign pc_height = "400px" %}
{% elsif image_height == "origin" %}
  {% assign mobile_height = 'origin' %}
  {% assign pc_height = 'origin' %}
{% else if image_height == nil %}
  {% assign mobile_height = "325px" %}
  {% assign pc_height = "450px" %}
{% endif %}

{% comment %} Mobile {% endcomment %}
<div class="d-md-none w-100 overlay-image">
  {% include 'hero_image', image_height: mobile_height, text_size: text_size, image_src: image_src, alignment: alignment, title: title, text: text, url: url, link_type: link_type, button_label: button_label, button_link: button_link, button_link_type: button_link_type, image_size: '1080x' %}
</div>
{% comment %} PC {% endcomment %}
<div class="d-none d-md-block w-100 overlay-image">
  {% include 'hero_image', image_height: pc_height, text_size: text_size, image_src: image_src, alignment: alignment, title: title, text: text, url: url, link_type: link_type, button_label: button_label, button_link: button_link, button_link_type: button_link_type, image_size: '1920x' %}
</div>
<style>
[data-section-id='{{section.id}}'] .hero__inner .mega-title{
  {% assign titleFont = settings.skin_title_font_family %}
  font-family: {{titleFont.family}},{{titleFont.fallback_families}};
  font-style: {{titleFont.style}};
  font-weight: {{titleFont.weight}};
}

[data-section-id='{{section.id}}'] .hero__inner .mega-title, [data-section-id='{{section.id}}'] .hero__inner .mega-subtitle{
  {% if text_color == nil %}
    color: #fff;
  {% else %}
    color: {{ text_color }};
  {% endif %}
}

@media screen and (max-width: 767.98px) {
  [data-section-id='{{section.id}}'] .hero__inner .page-width-outer {
    padding: 54px 15px;
  }

  {% if image_src == '' and image_height == "origin" %}
    [data-section-id='{{section.id}}'] .hero__bg .img {
      height: 260px!important;
    }
  {% endif %}
}

@media screen and (min-width: 768px) {
  [data-section-id='{{section.id}}'] .hero__inner .page-width-outer {
    width: 720px;
    margin: 0 auto;
    padding: 76px 0px;
  }

  {% if image_src == '' and image_height == "origin" %}
    [data-section-id='{{section.id}}'] .hero__bg .img {
      height: 450px!important;
    }
  {% endif %}
}

@media screen and (min-width: 992px) {
  [data-section-id='{{section.id}}'] .hero__inner .page-width-outer {
    width: 960px;
    margin: 0 auto;
    padding: 76px 0px;
  }
}

@media screen and (min-width: 1200px) {
  [data-section-id='{{section.id}}'] .hero__inner .page-width-outer {
    width: 1080px;
    margin: 0 auto;
    padding: 76px 0px;
  }
}

[data-section-id='{{section.id}}'] .hero__inner .page-width-outer {
  display: flex;
  height: 100%;
  {% if text_position == nil or text_position == 'center' %}
    align-items: center;
    justify-content: center;
  {% elsif text_position == 'top_left' %}
    align-items: flex-start;
    justify-content: flex-start;
  {% elsif text_position == 'top_center' %}
    align-items: flex-start;
    justify-content: center;
  {% elsif text_position == 'top_right' %}
    align-items: flex-start;
    justify-content: flex-end;
  {% elsif text_position == 'center_left' %}
    align-items: center;
    justify-content: flex-start;
  {% elsif text_position == 'center_right' %}
    align-items: center;
    justify-content: flex-end;
  {% elsif text_position == 'bottom_left' %}
    align-items: flex-end;
    justify-content: flex-start;
  {% elsif text_position == 'bottom_center' %}
    align-items: flex-end;
    justify-content: center;
  {% elsif text_position == 'bottom_right' %}
    align-items: flex-end;
    justify-content: flex-end;
  {% endif %}
}

[data-section-id='{{section.id}}'] .hero__inner .page-width {
  padding: 0;
  {% if text_justify == nil %}
    text-align: center;
  {% else %}
    text-align: {{ text_justify }};
  {% endif %}
}

{% if is_bottom_margin_show %}
  [data-section-id='{{section.id}}'] .overlay-image {
    padding-bottom: 40px;
  }
{% endif %}

[data-section-id='{{section.id}}'] .hero__inner {
  {% if overlay_bg_color == nil %}
    background: {{ '#000000' | color_modify: 'alpha', opacity }} !important;
  {% else %}
    background: {{ overlay_bg_color | color_modify: 'alpha', opacity }} !important;
  {% endif %}
}

[data-section-id='{{section.id}}'] .hero .hero-btn {
  {% if button_bg_color == nil %}
    background: #FFFFFF;
    border-color: #FFFFFF;
  {% else %}
    background: {{ button_bg_color }};
    border-color: {{ button_bg_color }};
  {% endif %}
  {% if button_text_color == nil %}
    color: #212121;
  {% else %}
    color: {{ button_text_color }};
  {% endif %}
}
[data-section-id='{{section.id}}'] .hero .hero-btn:hover {
  {% assign lighten = 5 %}
  {% if button_bg_color == '#ffffff' or button_bg_color == nil %}
    border-color: #f5f5f5 !important;
    background: #f5f5f5 !important;
  {% elsif button_bg_color == '#000000' %}
    border-color: #212121 !important;
    background: #212121 !important;
  {% else %}
    border-color: {{ button_bg_color | color_lighten: lighten }} !important;
    background: {{button_bg_color | color_lighten: lighten}} !important;
  {% endif %}
  {% if button_text_color == nil %}
    color: #212121 !important;
  {% else %}
    color: {{ button_text_color }} !important;
  {% endif %}
  cursor: pointer;
}
[data-section-id='{{section.id}}'] .hero .hero-btn:focus {
  {% assign darken = 5 %}
  {% if button_bg_color == '#ffffff' or button_bg_color == nil %}
    border-color: #f5f5f5 !important;
    background: #f5f5f5 !important;
  {% elsif button_bg_color == '#000000' %}
    border-color: #212121 !important;
    background: #212121 !important;
  {% else %}
    border-color: {{ button_bg_color | color_darken: lighten }} !important;
    background: {{button_bg_color | color_darken: lighten}} !important;
  {% endif %}
  {% if button_text_color == nil %}
    color: #212121 !important;
  {% else %}
    color: {{ button_text_color }} !important;
  {% endif %}
  cursor: pointer;
}
{% if is_galina_editorial %}
  .header_plus .menu-bg-color {
    background: rgba(255, 252, 249, 0.96);
    border-bottom: 1px solid rgba(34, 24, 20, 0.08);
    box-shadow: none;
  }
  .header_plus .header {
    min-height: 5.25rem;
  }
  .header_plus .header__logo img {
    max-width: 12.25rem;
    max-height: 3.55rem;
  }
  .header_plus .navigation-pc__menu-item_link,
  .header_plus .banner__color {
    letter-spacing: 0.04em;
  }
  .header_plus .navigation-pc__menu-item_link {
    font-size: 0.95rem;
  }
  [data-section-id='{{section.id}}'] .overlay-image {
    background:
      radial-gradient(circle at top left, rgba(255, 248, 243, 0.92), rgba(255, 248, 243, 0) 42%),
      linear-gradient(180deg, #fffdfa 0%, #fbf6f1 100%);
    padding-top: 0.75rem;
  }
  [data-section-id='{{section.id}}'] .hero,
  [data-section-id='{{section.id}}'] .hero > a,
  [data-section-id='{{section.id}}'] .hero__bg {
    border-radius: 2rem;
  }
  [data-section-id='{{section.id}}'] .hero {
    overflow: hidden;
    box-shadow: 0 28px 70px rgba(55, 38, 28, 0.18);
  }
  [data-section-id='{{section.id}}'] .hero__bg {
    height: 36rem !important;
    background-position: center center !important;
  }
  [data-section-id='{{section.id}}'] .hero__bg::before {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, rgba(16, 11, 9, 0.82) 0%, rgba(16, 11, 9, 0.62) 32%, rgba(16, 11, 9, 0.08) 58%, rgba(16, 11, 9, 0) 74%);
    content: '';
  }
  [data-section-id='{{section.id}}'] .hero__inner {
    z-index: 2;
    background: transparent !important;
  }
  [data-section-id='{{section.id}}'] .hero__inner .page-width-outer {
    width: min(1180px, 100%);
    padding: 3.5rem 3.5rem 3rem;
  }
  [data-section-id='{{section.id}}'] .hero__inner .page-width {
    max-width: 31rem;
    text-align: left !important;
    margin-left: 0;
  }
  [data-section-id='{{section.id}}'] .hero__inner .mega-title {
    margin: 0;
    color: #fff8f3 !important;
    font-family: "Baskerville", "Times New Roman", serif !important;
    font-size: clamp(3.2rem, 5vw, 4.9rem) !important;
    font-style: normal !important;
    font-weight: 400 !important;
    line-height: 0.92;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-shadow: 0 14px 36px rgba(0, 0, 0, 0.18);
  }
  [data-section-id='{{section.id}}'] .hero__inner .mega-subtitle {
    margin-top: 1.4rem;
    max-width: 25rem;
    color: rgba(255, 244, 237, 0.9) !important;
    font-size: 1rem !important;
    line-height: 1.85;
  }
  [data-section-id='{{section.id}}'] .hero .hero-btn {
    margin-top: 1.85rem;
    padding: 0.95rem 1.75rem;
    border: none !important;
    border-radius: 999px;
    background: linear-gradient(135deg, #c89a6d 0%, #a97853 100%) !important;
    color: #fffaf6 !important;
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow: 0 18px 32px rgba(104, 66, 40, 0.24);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  [data-section-id='{{section.id}}'] .hero .hero-btn:hover,
  [data-section-id='{{section.id}}'] .hero .hero-btn:focus {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #cfa47a 0%, #b1815d 100%) !important;
    box-shadow: 0 22px 38px rgba(104, 66, 40, 0.3);
  }
  #xfcart-section-8042317530 .common-card-title,
  [data-section-id='8042317530'] .common-card-title {
    margin-bottom: 2.25rem !important;
    color: #231916;
    font-family: "Baskerville", "Times New Roman", serif;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  #xfcart-section-8042317530 .product-snippet,
  [data-section-id='8042317530'] .product-snippet {
    border-radius: 1.4rem;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 14px 34px rgba(58, 40, 29, 0.08);
  }
  #xfcart-section-8042317530 .product-snippet__img-wrapper,
  [data-section-id='8042317530'] .product-snippet__img-wrapper {
    background: linear-gradient(180deg, #fdf9f5 0%, #f5ebe2 100%);
  }
  @media (max-width: 767.98px) {
    [data-section-id='{{section.id}}'] .overlay-image {
      padding-top: 0.35rem;
    }
    [data-section-id='{{section.id}}'] .hero__bg {
      height: 33rem !important;
      background-position: 72% center !important;
    }
    [data-section-id='{{section.id}}'] .hero__inner .page-width-outer {
      padding: 2rem 1.5rem 2.1rem !important;
      justify-content: flex-end;
      align-items: flex-end;
    }
    [data-section-id='{{section.id}}'] .hero__inner .page-width {
      max-width: none;
    }
    [data-section-id='{{section.id}}'] .hero__inner .mega-title {
      font-size: 2.55rem !important;
    }
    [data-section-id='{{section.id}}'] .hero__inner .mega-subtitle {
      font-size: 0.94rem !important;
      line-height: 1.7;
    }
    [data-section-id='{{section.id}}'] .hero .hero-btn {
      width: 100%;
      text-align: center;
      letter-spacing: 0.12em;
    }
  }
{% endif %}
</style>

{% javascript %}

  {% comment %} Calculate the padding of the origin size image {% endcomment %}
  $(function(){
    var imageHeightType = {{ section.settings.image_height | json }};
    {% if images[image_src].height and images[image_src].width %}
    var imageHeight = {{ images[image_src].height | json }};
    var imageWidth = {{ images[image_src].width | json }};
    var imageRealHeight = $(window).width() * (imageHeight / imageWidth);
    var imagePadding = imageRealHeight * 0.15 + 'px';
    if(imageHeightType === 'origin') {
      $("[data-section-id='{{section.id}}'] .hero__inner .page-width-outer").css({
        'padding-top': imagePadding,
        'padding-bottom': imagePadding
      })
    }
    {% endif %}
  });
{% endjavascript %}

