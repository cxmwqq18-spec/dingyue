{% assign p = collections[section.settings.collection.id].products %}
{% assign is_galina_editorial = false %}
{% if shop.id == '145' or shop.domain contains 'galinamcreations.com' %}
  {% assign is_galina_editorial = true %}
{% endif %}
{% assign is_whiteribbon_boutique = false %}
{% if shop.id == '144' or shop.domain contains 'whiteribbonboutiques.com' %}
  {% assign is_whiteribbon_boutique = true %}
{% endif %}
{% if section.settings.is_show_recommended_products != nil %}
  {% assign isShowRecommendedProducts = section.settings.is_show_recommended_products %}
{% else %}
  {% assign isShowRecommendedProducts = true %}
{% endif %}
{% if isShowRecommendedProducts %}
  {% if product.recommend_collection_id != nil %}
    {% if collections[product.recommend_collection_id]].products.size > 0%}
      {% assign p = collections[product.recommend_collection_id]].products %}
    {% endif %}
  {% endif %}
{% endif %}

{% if p.size > 0 or shop.env == 1 %}
  {% if is_whiteribbon_boutique %}
    <section class="whiteribbon-products">
      <style>
        #xfcart-section-{{section.id}} .whiteribbon-products .container {
          padding-top: 26px;
          padding-bottom: 18px;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products__eyebrow {
          display: inline-flex;
          align-items: center;
          gap: 12px;
          color: #d67b84;
          font-size: 0.82rem;
          font-weight: 700;
          letter-spacing: 0.18em;
          text-transform: uppercase;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products__heading {
          margin-bottom: 34px;
          text-align: center;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products__eyebrow::before,
        #xfcart-section-{{section.id}} .whiteribbon-products__eyebrow::after {
          width: 40px;
          height: 1px;
          background: rgba(214, 123, 132, 0.5);
          content: '';
        }
        #xfcart-section-{{section.id}} .whiteribbon-products__title {
          margin: 16px 0 0;
          color: #1f1718;
          font-family: Georgia, "Times New Roman", serif;
          font-size: clamp(2.2rem, 3.6vw, 3.45rem);
          line-height: 1.08;
          font-weight: 400;
          letter-spacing: -0.04em;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products .common__product-gap {
          margin-bottom: 2.4rem;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products .product-snippet__img-wrapper {
          overflow: hidden;
          border-radius: 18px;
          background: #fff8f6;
          box-shadow: 0 18px 36px rgba(63, 34, 39, 0.08);
        }
        #xfcart-section-{{section.id}} .whiteribbon-products .product-snippet__title-normal {
          margin-top: 16px;
          color: #241b1b;
          font-size: 0.98rem;
          line-height: 1.5;
          font-weight: 600;
          text-align: center;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products .product-snippet__price-wrapper {
          margin-top: 8px;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products .xf_skin_product_price {
          color: #dd7c85 !important;
          font-size: 1.05rem;
          font-weight: 700;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products__cta.btn.btn-primary {
          min-width: 238px;
          margin-top: 0.75rem;
          padding: 0.95rem 1.8rem;
          border: 1px solid rgba(36, 27, 27, 0.18) !important;
          border-radius: 6px;
          background: #fff !important;
          color: #241b1b !important;
          font-size: 0.84rem;
          font-weight: 700;
          letter-spacing: 0.12em;
          text-transform: uppercase;
          box-shadow: none;
        }
        #xfcart-section-{{section.id}} .whiteribbon-products__cta.btn.btn-primary:hover,
        #xfcart-section-{{section.id}} .whiteribbon-products__cta.btn.btn-primary:focus {
          border-color: #dd7c85 !important;
          background: #dd7c85 !important;
          color: #fff !important;
        }
      </style>
      <div class="container container-gap">
        <div class="whiteribbon-products__heading">
          <span class="whiteribbon-products__eyebrow">Curated For You</span>
          <h2 class="whiteribbon-products__title">{{ section.settings.name | default: 'Featured Collection' }}</h2>
        </div>
  {% else %}
  <div class="container container-gap">{% comment %} 卡片标题 {% endcomment %}
    {% if section.settings.name %}
      {% include 'card_title', title: section.settings.name, titlePath: 'name' %}
    {% endif %}
  {% endif %}
    {% assign grid = section.settings.grid | default: 4 %}
    {% case grid %}
      {% when 2 %}
        {% assign colMd="col-md-6"%}
      {% when 3 %}
        {% assign colMd="col-md-4"%}
      {% when 4 %}
        {% assign colMd="col-md-3"%}
      {% when 5 %}
        {% assign colMd="col-md-2_4"%}
      {% else %}
        {% assign colMd="col-md-3"%}
    {% endcase %}
    {% if grid == 2 %}
      {% assign col="col-12"%}
    {% else %}
      {% assign col="col-6"%}
    {% endif %}

    {% case section.settings.image_size %}
      {% when "small" %}
        {% assign imageHeight="100%" %}
      {% when "medium" %}
        {% assign imageHeight="121%" %}
      {% when "large" %}
        {% assign imageHeight="150%" %}
      {% when "auto" %}
        {% assign imageHeight="auto" %}
      {% else %}
        {% assign imageHeight="100%" %}
    {% endcase %}

    <div class="row common__product-row">
      {% comment %} 渲染C端节点 {% endcomment %}
      {% assign lineNumber = section.settings.line_number | times: grid %}
      {% assign showProductNum = 0 %}
      {% assign collection_id = section.settings.collection.id %}
      {% for block in p %}
        {% if showProductNum < lineNumber %}
          {% if block.published %}
            <div class="{{col}} {{colMd}} common__product-gap">
              {% include 'product', product: block, image_size: imageHeight %}
            </div>
            {% assign showProductNum = showProductNum | plus: 1 %}
          {% endif %}
        {% endif %}
      {% endfor %}
      {% comment %} 补充模拟数据 {% endcomment %}
      {% if shop.env == 1 %}
        {% assign num = lineNumber | minus: showProductNum %}
        {% for block in (1..num) %}

          <div class="{{col}} {{colMd}} common__product-gap">
            {% include 'product', product: default_product, image_size: imageHeight %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
    {% if section.settings.view_all or is_galina_editorial or is_whiteribbon_boutique %}
      <div class="text-center">
        <a href="{{ section.settings.collection.url }}" class="btn btn-primary{% if is_galina_editorial %} galina-products__cta{% endif %}{% if is_whiteribbon_boutique %} whiteribbon-products__cta{% endif %}">{% if is_galina_editorial or is_whiteribbon_boutique %}View All Collections{% else %}{{ langs.collections.general.all_of_collection | t }}{% endif %}</a>
      </div>
    {% endif %}
    {% if is_whiteribbon_boutique %}
      </div>
    </section>
    {% else %}
  </div>
    {% endif %}
{% endif %}
{% if is_galina_editorial %}
  <style>
    #xfcart-section-{{section.id}} .galina-products__cta.btn.btn-primary {
      margin-top: 1rem;
      min-width: 15rem;
      padding: 0.95rem 1.75rem;
      border: none !important;
      border-radius: 999px;
      background: linear-gradient(135deg, #c89a6d 0%, #a97853 100%) !important;
      box-shadow: 0 18px 32px rgba(104, 66, 40, 0.18);
      color: #fffaf6 !important;
      font-size: 0.84rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    #xfcart-section-{{section.id}} .galina-products__cta.btn.btn-primary:hover,
    #xfcart-section-{{section.id}} .galina-products__cta.btn.btn-primary:focus {
      background: linear-gradient(135deg, #cfa47a 0%, #b1815d 100%) !important;
      color: #fffaf6 !important;
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "products",
  "contentType": [
    "products"
  ],
  "settings": [
    {
      "type": "header",
      "content": {
        "en-US": "Content",
        "zh-CN": "内容"
      }
    },
    {
      "type": "collection",
      "id": "collection",
      "label": {
        "en-US": "Add collection",
        "zh-CN": "添加统一专辑"
      }
    },
    {
      "type": "header",
      "content": {
        "en-US": "Settings",
        "zh-CN": "设置"
      }
    },
    {
      "type": "text",
      "id": "name",
      "label": {
        "en-US": "Heading",
        "zh-CN": "标题"
      },
      "default": "Featured collection",
      "placeholder": {
        "zh-CN": "请输入内容",
        "en-US": "Input heading"
      }
    },
    {
      "type": "range",
      "label": {
        "zh-CN": "PC展示排数",
        "en-US": "Show rows on desktop"
      },
      "id": "line_number",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "label": {
        "zh-CN": "PC每排商品数",
        "en-US": "Show products per row on desktop"
      },
      "id": "grid",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "label": {
        "zh-CN": "图片高度",
        "en-US": "Image height"
      },
      "id": "image_size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": {
            "zh-CN": "小",
            "en-US": "Small"
          }
        },
        {
          "value": "medium",
          "label": {
            "zh-CN": "中",
            "en-US": "Medium"
          }
        },
        {
          "value": "large",
          "label": {
            "zh-CN": "大",
            "en-US": "Large"
          }
        },
        {
          "value": "auto",
          "label": {
            "zh-CN": "原始比例",
            "en-US": "Natural"
          }
        }
      ]
    },
    {
      "type": "checkbox",
      "label": {
        "zh-CN": "显示”View all“",
        "en-US": "Show \"View all\""
      },
      "id": "view_all",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "products",
      "cname": {
        "zh-CN": "专辑商品",
        "en-US": "Collection products"
      },
      "category": {
        "en-US": "Product",
        "zh-CN": "商品"
      },
      "ccategory": {
        "en-US": "Product",
        "zh-CN": "商品"
      },
      "display": true,
      "is_show_recommended_products": true,
      "view_all": false,
      "blocks": []
    }
  ]
}
{% endschema %}
