<style>

  .container_wrapper ul, .container_wrapper li, .container_wrapper p, .container_wrapper div {
    padding: 0px;
    margin: 0px;
  }

  @media (max-width: 1200px) {
    .container_wrapper {
      padding-left: 50px;
      padding-right: 50px;
      box-sizing: border-box;
    }
  }

  @media (max-width: 767px) {
    .container_wrapper {
      padding-left: 15px;
      padding-right: 15px;
      box-sizing: border-box;
    }
  }

  .block_slogan .list .list_item .img_box svg {
    height: 40px;
    width: 40px;
  }

  .block_slogan .list .list_item .img_box svg path {
    fill: var(--title-color);
  }

  .container_wrapper {
    width: 100%;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .md\:gap-5 {
      gap: 1.25rem;
    }
    .md\:grid-cols-2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .lg\:grid-cols-4 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .grid {
    display: grid;
  }

  .block_slogan .list .list_item {
    padding: 20px;
    box-shadow: 0 0 0 1px rgb(218, 218, 218), 0 3px 0 rgba(218, 218, 218, 0.3);
    border-radius: 2px;
    background-color: #fff;
  }

  .items-center {
    align-items: center;
  }

  .flex {
    display: flex;
  }
  .mr-4 {
    margin-right: 1rem!important;
  }

  .block_slogan .list .list_item .text_box .item_title {
    font-size: 16px;
    font-family: "Arimo";
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    color: var(--title-color);
  }

  .block_slogan .list .list_item .text_box .item_detail {
    font-size: 13px;
    color: #676767;
  }

  .mt-1 {
    margin-top: 0.25rem;
  }
</style>
