generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformStateDocument {
  id        String   @id
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSetting {
  id        String   @id
  key       String   @unique
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformEmailSettings {
  id        String   @id @default("platform_email_settings")
  provider  String   @default("resend")
  apiKey    String?
  fromEmail String?
  replyTo   String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformEmailConfig {
  id              String                      @id
  label           String
  provider        String                      @default("resend")
  apiKey          String?
  fromEmail       String?
  replyTo         String?
  isDefault       Boolean                     @default(false)
  updatedBy       String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  siteAssignments SiteEmailConfigAssignment[]

  @@index([isDefault])
}

model SiteEmailConfigAssignment {
  siteId    String
  configId  String
  updatedBy String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  site      Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  config    PlatformEmailConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@id([siteId])
  @@index([configId])
}

model PlatformAdmin {
  id           String            @id
  email        String            @unique
  passwordHash String?
  displayName  String
  role         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     PlatformSession[]
}

model PlatformSession {
  id              String        @id
  platformAdminId String
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([expiresAt])
}

model PlatformCloudflareAccount {
  id        String   @id
  label     String
  email     String
  accountId String
  apiToken  String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, accountId])
  @@index([accountId])
}

model PlatformAiProvider {
  id        String   @id
  label     String
  aiUrl     String
  apiKey    String?
  modelType String
  priority  Int      @default(0)
  preferred Boolean  @default(false)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([preferred, priority])
}

model PlatformAsyncJob {
  id         String    @id
  kind       String
  status     String
  actorId    String?
  metadata   Json
  result     Json?
  error      Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?
  expiresAt  DateTime

  @@index([actorId, createdAt])
  @@index([kind, status])
  @@index([expiresAt])
}

model Site {
  id                 String                      @id
  name               String
  slug               String                      @unique
  status             String
  primaryDomain      String
  timezone           String                      @default("UTC")
  currency           String                      @default("usd")
  signupCreditGrant  Int                         @default(0)
  branding           Json
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  domains            SiteDomain[]
  admins             SiteAdmin[]
  adminSessions      SiteAdminSession[]
  customers          Customer[]
  customerSessions   CustomerSession[]
  emailVerifications CustomerEmailVerification[]
  products           Product[]
  prices             Price[]
  subscriptions      Subscription[]
  orders             Order[]
  paymentEvents      PaymentEvent[]
  ledger             CreditLedger[]
  balances           CreditBalance[]
  pages              ThemePage[]
  settings           ThemeSettings?
  publications       ThemePublication[]
  siteThemes         SiteTheme[]
  themeCopies        ThemeCopy[]
  connect            StripeConnectAccount?
  aiApps             SiteAiApp[]
  gatewayGroups      AiGatewayGroup[]
  toolCategories     ToolCategory[]
  toolMenuItems      ToolMenuItem[]
  creativePackCategories CreativePackCategory[]
  creativePacks      CreativePack[]
  mediaAssets        MediaAsset[]
  customerModels     CustomerModel[]
  albums             Album[]
  jobs               GenerationJob[]
  uploads            AssetUpload[]
  auditLogs          AuditLog[]
  partnerApplications PartnerApplication[]
  emailConfigAssignment SiteEmailConfigAssignment?

  @@index([status])
  @@index([primaryDomain])
  @@index([status, createdAt])
  @@index([createdAt])
}

model SiteDomain {
  id                   String   @id
  siteId               String
  domain               String   @unique
  isPrimary            Boolean  @default(false)
  status               String
  allowedAiProviderIds String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  site                 Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isPrimary])
  @@index([siteId, status])
  @@index([siteId, isPrimary, createdAt])
  @@index([siteId, status, createdAt])
}

model SiteAdmin {
  id           String             @id
  siteId       String
  email        String
  passwordHash String?
  displayName  String
  role         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  site         Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions     SiteAdminSession[]

  @@unique([siteId, email])
  @@index([siteId, role])
  @@index([siteId, role, createdAt])
}

model SiteAdminSession {
  id          String    @id
  siteId      String
  siteAdminId String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteAdmin   SiteAdmin @relation(fields: [siteAdminId], references: [id], onDelete: Cascade)

  @@index([siteId, siteAdminId])
  @@index([expiresAt])
}

model Customer {
  id            String            @id
  siteId        String
  email         String
  passwordHash  String?
  name          String
  status        String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  site          Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions      CustomerSession[]
  subscriptions Subscription[]
  orders        Order[]
  ledger        CreditLedger[]
  balance       CreditBalance?
  jobs          GenerationJob[]
  uploads       AssetUpload[]
  models        CustomerModel[]
  albums        Album[]

  @@unique([siteId, email])
  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([siteId, status, createdAt])
}

model CustomerSession {
  id         String   @id
  siteId     String
  customerId String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([siteId, customerId])
  @@index([siteId, customerId, expiresAt])
  @@index([expiresAt])
}

model StripeConnectAccount {
  id               String   @id
  siteId           String   @unique
  stripeAccountId  String   @unique
  onboardingStatus String
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model CustomerEmailVerification {
  id                String    @id
  siteId            String
  email             String
  codeHash          String
  purpose           String
  attempts          Int       @default(0)
  providerMessageId String?
  deliveryStatus    String?
  deliveryError     String?
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  site              Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, email, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model Product {
  id            String         @id
  siteId        String
  name          String
  type          String
  status        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  prices        Price[]
  subscriptions Subscription[]

  @@index([siteId, status])
  @@index([siteId, type])
  @@index([siteId, status, createdAt])
  @@index([siteId, type, createdAt])
}

model Price {
  id             String         @id
  siteId         String
  productId      String
  label          String
  amountCents    Int
  currency       String
  interval       String
  creditsGranted Int
  stripePriceId  String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions  Subscription[]

  @@unique([siteId, stripePriceId])
  @@index([siteId, productId])
  @@index([siteId, interval])
}

model Subscription {
  id                   String    @id
  siteId               String
  customerId           String
  productId            String
  priceId              String
  stripeSubscriptionId String    @unique
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime
  creditsPerCycle      Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product              Product   @relation(fields: [productId], references: [id])
  price                Price     @relation(fields: [priceId], references: [id])

  @@index([siteId, customerId, status])
  @@index([siteId, productId])
  @@index([siteId, status, createdAt])
  @@index([siteId, status, currentPeriodEnd])
}

model Order {
  id          String   @id
  siteId      String
  customerId  String
  status      String
  amountCents Int
  currency    String
  credits     Int
  sourceId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([siteId, customerId, createdAt])
  @@index([siteId, status])
  @@index([siteId, sourceId])
  @@index([siteId, status, createdAt])
}

model PaymentEvent {
  id              String    @id
  siteId          String
  provider        String
  providerEventId String
  eventType       String
  processedAt     DateTime?
  payload         Json
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, provider, providerEventId])
  @@index([siteId, eventType])
  @@index([siteId, processedAt])
  @@index([processedAt])
}

model CreditLedger {
  id         String    @id
  siteId     String
  customerId String
  amount     Int
  type       String
  sourceType String
  sourceId   String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([siteId, customerId, createdAt])
  @@index([siteId, sourceType, sourceId])
  @@index([siteId, type, createdAt])
}

model CreditBalance {
  id         String   @id
  siteId     String
  customerId String   @unique
  balance    Int      @default(0)
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([siteId, customerId])
  @@index([siteId])
}

model AiApp {
  id              String          @id
  slug            String          @unique
  name            String
  description     String
  appType         String
  parameterSchema Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sites           SiteAiApp[]
  jobs            GenerationJob[]

  @@index([appType])
}

model SiteAiApp {
  id             String   @id
  siteId         String
  aiAppId        String
  enabled        Boolean  @default(true)
  creditCost     Int
  routeKey       String
  workflowConfig Json?
  providerConfig Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  aiApp          AiApp    @relation(fields: [aiAppId], references: [id], onDelete: Cascade)

  @@unique([siteId, aiAppId])
  @@unique([siteId, routeKey])
  @@index([siteId, enabled])
  @@index([siteId, enabled, routeKey])
}

model ToolCategory {
  id          String   @id
  siteId      String
  parentId    String?
  slug        String
  label       String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent      ToolCategory? @relation("ToolCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    ToolCategory[] @relation("ToolCategoryChildren")
  menuItems   ToolMenuItem[]

  @@unique([siteId, slug])
  @@index([siteId, parentId, sortOrder])
  @@index([siteId, status])
}

model ToolMenuItem {
  id          String   @id
  siteId      String
  categoryId  String?
  slug        String
  title       String
  description String?
  badge       String?
  icon        String?
  imageUrl    String?
  href        String
  detailJson  Json?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category    ToolCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([siteId, slug])
  @@index([siteId, categoryId, sortOrder])
  @@index([siteId, status])
}

model AiGatewayGroup {
  id                 String   @id
  siteId             String
  name               String
  status             String
  modelAllowlist     String[]
  monthlyQuota       Int
  usedQuota          Int      @default(0)
  retryStatusCodes   Int[]
  rateLimitPerMinute Int
  accountPoolMode    String
  unavailableReason  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@index([siteId, status])
  @@index([siteId, status, name])
}

model ThemePage {
  id            String   @id
  siteId        String
  pageType      String
  templateKey   String?
  slug          String
  title         String
  draftJson     Json
  publishedJson Json
  draftMeta     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId, pageType])
  @@index([siteId, templateKey])
  @@index([siteId, updatedAt])
}

model ThemeSettings {
  id            String   @id
  siteId        String   @unique
  draftJson     Json
  publishedJson Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model ThemePublication {
  id            String   @id
  siteId        String
  version       Int
  snapshot      Json
  pageCount     Int?
  sectionCount  Int?
  snapshotBytes Int?
  publishedBy   String
  publishedAt   DateTime @default(now())
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, version])
  @@index([siteId, publishedAt])
  @@index([siteId, version])
}

model SiteTheme {
  id        String   @id
  siteId    String
  name      String
  themeId   String
  themeKey  String
  status    String
  templates Json
  settings  Json
  source    String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, themeId])
  @@index([siteId, status])
  @@index([siteId, themeKey])
}

model ThemeCopy {
  id        String   @id
  siteId    String
  name      String
  themeKey  String
  source    String
  templates Json
  settings  Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, themeKey])
  @@index([siteId, createdAt])
}

model SectionDefinition {
  id          String @id
  type        String @unique
  label       String
  category    String
  schemaJson  Json
  previewJson Json
}

model MediaAsset {
  id         String   @id
  siteId     String
  label      String
  storageKey String
  mimeType   String
  usageType  String
  sourceType String?
  previewUrl String?
  originUrl  String?
  altText    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, storageKey])
  @@index([siteId, usageType])
  @@index([siteId, usageType, createdAt])
  @@index([siteId, createdAt])
}

model CreativePack {
  id               String   @id
  siteId           String
  categoryId       String?
  name             String
  headline         String
  description      String
  prompt           String?
  category         String
  aiAppSlug        String
  status           String
  creditCost       Int
  outputCount      Int
  trainingRequired Boolean  @default(false)
  generationCount  Int      @default(0)
  conversionRate   Float    @default(0)
  imageUrl         String?
  galleryImages    Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  categoryRecord   CreativePackCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  albums           Album[]

  @@index([siteId, status])
  @@index([siteId, category])
  @@index([siteId, categoryId])
  @@index([siteId, aiAppSlug])
  @@index([siteId, status, createdAt])
}

model CreativePackCategory {
  id          String   @id
  siteId      String
  parentId    String?
  slug        String
  label       String
  description String?
  heroTitle   String?
  heroSubtitle String?
  icon        String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent      CreativePackCategory? @relation("CreativePackCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    CreativePackCategory[] @relation("CreativePackCategoryChildren")
  packs       CreativePack[]

  @@unique([siteId, slug])
  @@index([siteId, parentId, sortOrder])
  @@index([siteId, status])
}

model CustomerModel {
  id              String        @id
  siteId          String
  customerId      String
  label           String
  modelType       String
  status          String
  inputAssetCount Int
  minInputAssets  Int
  providerModelId String?
  trainingJobId   String?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploads         AssetUpload[]

  @@index([siteId, customerId, status])
  @@index([siteId, providerModelId])
  @@index([siteId, status, updatedAt])
  @@index([siteId, updatedAt])
}

model Album {
  id             String         @id
  siteId         String
  customerId     String
  title          String
  sourceJobId    String?
  creativePackId String?
  status         String
  outputCount    Int
  coverAssetId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceJob      GenerationJob? @relation(fields: [sourceJobId], references: [id])
  creativePack   CreativePack?  @relation(fields: [creativePackId], references: [id])
  coverAsset     AssetUpload?   @relation("AlbumCoverAsset", fields: [coverAssetId], references: [id])

  @@index([siteId, customerId, status])
  @@index([siteId, sourceJobId])
  @@index([siteId, creativePackId])
  @@index([siteId, status, updatedAt])
  @@index([siteId, updatedAt])
}

model AssetUpload {
  id               String         @id
  siteId           String
  customerId       String
  customerModelId  String?
  subjectRole      String?
  jobId            String?
  label            String
  storageKey       String
  mimeType         String
  role             String
  visibility       String
  reviewStatus     String
  validationStatus String?
  validationReport Json?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  site             Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer         Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerModel    CustomerModel? @relation(fields: [customerModelId], references: [id])
  job              GenerationJob? @relation(fields: [jobId], references: [id])
  albumCovers      Album[]        @relation("AlbumCoverAsset")

  @@index([siteId, storageKey])
  @@index([siteId, customerId, role])
  @@index([siteId, customerModelId])
  @@index([siteId, jobId])
  @@index([siteId, reviewStatus])
  @@index([siteId, reviewStatus, createdAt])
  @@index([siteId, customerId, createdAt])
  @@index([siteId, createdAt])
}

model PartnerApplication {
  id          String   @id
  siteId      String
  email       String
  name        String
  company     String?
  website     String?
  socialLinks Json?
  audience    String?
  cadence     String?
  campaignIdeas String?
  message     String?
  status      String   @default("pending")
  source      String?
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNote  String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([siteId, status, createdAt])
  @@index([siteId, email])
}

model GenerationJob {
  id              String        @id
  siteId          String
  customerId      String
  aiAppId         String
  status          String
  creditsReserved Int
  requestJson     Json
  resultJson      Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  aiApp           AiApp         @relation(fields: [aiAppId], references: [id])
  uploads         AssetUpload[]
  albums          Album[]

  @@index([siteId, customerId, createdAt])
  @@index([siteId, status])
  @@index([siteId, aiAppId])
  @@index([siteId, status, updatedAt])
  @@index([siteId, updatedAt])
  @@index([status, updatedAt])
}

model AuditLog {
  id         String   @id
  siteId     String?
  actorType  String
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
