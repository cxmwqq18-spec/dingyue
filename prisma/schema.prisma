generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlatformStateDocument {
  id        String   @id
  state     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformSetting {
  id        String   @id
  key       String   @unique
  value     Json
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformEmailSettings {
  id        String   @id @default("platform_email_settings")
  provider  String   @default("resend")
  apiKey    String?
  fromEmail String?
  replyTo   String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformEmailConfig {
  id              String                      @id
  label           String
  provider        String                      @default("resend")
  apiKey          String?
  fromEmail       String?
  replyTo         String?
  isDefault       Boolean                     @default(false)
  updatedBy       String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  siteAssignments SiteEmailConfigAssignment[]

  @@index([isDefault])
}

model SiteEmailConfigAssignment {
  siteId    String
  configId  String
  updatedBy String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  site      Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  config    PlatformEmailConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@id([siteId])
  @@index([configId])
}

model PlatformAdmin {
  id           String            @id
  email        String            @unique
  passwordHash String?
  displayName  String
  role         String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     PlatformSession[]
}

model PlatformSession {
  id              String        @id
  platformAdminId String
  createdAt       DateTime      @default(now())
  expiresAt       DateTime
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([expiresAt])
}

model PlatformCloudflareAccount {
  id        String   @id
  label     String
  email     String
  accountId String
  apiToken  String
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email, accountId])
  @@index([accountId])
}

model PlatformAiProvider {
  id                  String   @id
  label               String
  aiUrl               String
  apiKey              String?
  modelType           String
  providerType        String   @default("image")
  priority            Int      @default(0)
  preferred           Boolean  @default(false)
  enabled             Boolean  @default(true)
  supportsGenerationN Boolean  @default(false)
  supportsEditN       Boolean  @default(false)
  maxImagesPerRequest Int      @default(1)
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([preferred, priority])
  @@index([enabled, preferred, priority])
  @@index([providerType, preferred, priority])
  @@index([providerType, enabled, preferred, priority])
}

model PlatformAsyncJob {
  id             String    @id
  kind           String
  status         String
  actorId        String?
  idempotencyKey String?
  metadata       Json
  result         Json?
  error          Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  startedAt      DateTime?
  finishedAt     DateTime?
  expiresAt      DateTime

  @@unique([kind, actorId, idempotencyKey])
  @@index([actorId, createdAt])
  @@index([kind, status])
  @@index([expiresAt])
}

model Site {
  id                      String                      @id
  name                    String
  slug                    String                      @unique
  status                  String
  primaryDomain           String
  timezone                String                      @default("UTC")
  currency                String                      @default("usd")
  signupCreditGrant       Int                         @default(0)
  branding                Json
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  domains                 SiteDomain[]
  admins                  SiteAdmin[]
  adminSessions           SiteAdminSession[]
  customers               Customer[]
  customerProfiles        CustomerProfile[]
  customerSessions        CustomerSession[]
  emailVerifications      CustomerEmailVerification[]
  products                Product[]
  prices                  Price[]
  subscriptions           Subscription[]
  orders                  Order[]
  paymentEvents           PaymentEvent[]
  ledger                  CreditLedger[]
  balances                CreditBalance[]
  pages                   ThemePage[]
  livePages               LivePage[]
  settings                ThemeSettings?
  storefrontProfile       StorefrontProfile?
  currentPublishedState   SitePublishedState?
  publications            ThemePublication[]
  publishApprovals         ThemePublishApproval[]
  activePublication       ActiveThemePublication?
  siteThemes              SiteTheme[]
  themeCopies             ThemeCopy[]
  connect                 StripeConnectAccount?
  aiApps                  SiteAiApp[]
  apiKeys                 SiteApiKey[]
  gatewayGroups           AiGatewayGroup[]
  toolCategories          ToolCategory[]
  toolMenuItems           ToolMenuItem[]
  creativePackCategories  CreativePackCategory[]
  creativePacks           CreativePack[]
  videoThemeCategories    VideoThemeCategory[]
  videoThemes             VideoTheme[]
  videoThemeExamples      VideoThemeExample[]
  videoThemeSlugRedirects VideoThemeSlugRedirect[]
  mediaAssets             MediaAsset[]
  customerModels          CustomerModel[]
  albums                  Album[]
  jobs                    GenerationJob[]
  uploads                 AssetUpload[]
  customerDownloads       CustomerAssetDownload[]
  auditLogs               AuditLog[]
  partnerApplications     PartnerApplication[]
  emailConfigAssignment   SiteEmailConfigAssignment?
  contentSyncBaselines     ContentSyncBaseline[]

  @@index([status])
  @@index([primaryDomain])
  @@index([status, createdAt])
  @@index([createdAt])
}

/// Hash-only field baselines used by the public-content incremental sync.
/// Values are deliberately not stored here: the target database remains the
/// source of truth and an online edit therefore wins a stale local operation.
model ContentSyncBaseline {
  id          String   @id
  target      String
  siteId      String
  entityType  String
  entityKey   String
  fieldPath   String
  valueHash   String
  syncedAt    DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([target, siteId, entityType, entityKey, fieldPath])
  @@index([target, siteId, entityType])
}

model SiteDomain {
  id                   String   @id
  siteId               String
  domain               String   @unique
  isPrimary            Boolean  @default(false)
  status               String
  allowedAiProviderIds String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  site                 Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, isPrimary])
  @@index([siteId, status])
  @@index([siteId, isPrimary, createdAt])
  @@index([siteId, status, createdAt])
}

model SiteAdmin {
  id           String             @id
  siteId       String
  email        String
  passwordHash String?
  displayName  String
  role         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  site         Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions     SiteAdminSession[]

  @@unique([siteId, email])
  @@index([siteId, role])
  @@index([siteId, role, createdAt])
}

model SiteAdminSession {
  id          String    @id
  siteId      String
  siteAdminId String
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteAdmin   SiteAdmin @relation(fields: [siteAdminId], references: [id], onDelete: Cascade)

  @@index([siteId, siteAdminId])
  @@index([expiresAt])
}

model Customer {
  id            String                  @id
  siteId        String
  email         String
  passwordHash  String?
  name          String
  status        String
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  site          Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  sessions      CustomerSession[]
  profile       CustomerProfile?
  subscriptions Subscription[]
  orders        Order[]
  ledger        CreditLedger[]
  balance       CreditBalance?
  jobs          GenerationJob[]
  uploads       AssetUpload[]
  downloads     CustomerAssetDownload[]
  models        CustomerModel[]
  albums        Album[]

  @@unique([siteId, email])
  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([siteId, status, createdAt])
}

model CustomerProfile {
  id            String       @id
  siteId        String
  customerId    String       @unique
  avatarAssetId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  site          Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer      Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  avatarAsset   AssetUpload? @relation("CustomerProfileAvatarAsset", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@index([siteId])
  @@index([siteId, avatarAssetId])
}

model CustomerSession {
  id         String   @id
  siteId     String
  customerId String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([siteId, customerId])
  @@index([siteId, customerId, expiresAt])
  @@index([expiresAt])
}

model StripeConnectAccount {
  id               String   @id
  siteId           String   @unique
  stripeAccountId  String   @unique
  onboardingStatus String
  chargesEnabled   Boolean  @default(false)
  payoutsEnabled   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  site             Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model CustomerEmailVerification {
  id                String    @id
  siteId            String
  email             String
  codeHash          String
  purpose           String
  attempts          Int       @default(0)
  providerMessageId String?
  deliveryStatus    String?
  deliveryError     String?
  consumedAt        DateTime?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  site              Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, email, expiresAt])
  @@index([expiresAt])
  @@index([consumedAt])
}

model Product {
  id            String         @id
  siteId        String
  name          String
  type          String
  status        String
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  site          Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  prices        Price[]
  subscriptions Subscription[]

  @@index([siteId, status])
  @@index([siteId, type])
  @@index([siteId, status, createdAt])
  @@index([siteId, type, createdAt])
}

model Price {
  id                  String         @id
  siteId              String
  productId           String
  label               String
  amountCents         Int
  currency            String
  interval            String
  creditsGranted      Int
  stripePriceId       String?
  metadata            Json?
  status              String         @default("draft")
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  replacesPriceId     String?
  providerVerifiedAt  DateTime?
  providerFingerprint String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  site                Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions       Subscription[]
  orders              Order[]

  @@unique([siteId, stripePriceId])
  @@index([siteId, productId])
  @@index([siteId, interval])
  @@index([siteId, status, effectiveFrom, effectiveTo])
  @@index([productId, createdAt])
}

model Subscription {
  id                   String    @id
  siteId               String
  customerId           String
  productId            String
  priceId              String
  stripeSubscriptionId String    @unique
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime
  creditsPerCycle      Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  site                 Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer             Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product              Product   @relation(fields: [productId], references: [id])
  price                Price     @relation(fields: [priceId], references: [id])

  @@index([siteId, customerId, status])
  @@index([siteId, customerId, createdAt])
  @@index([siteId, productId])
  @@index([siteId, createdAt])
  @@index([siteId, status, createdAt])
  @@index([siteId, status, currentPeriodEnd])
}

model Order {
  id          String   @id
  siteId      String
  customerId  String
  priceId     String?
  status      String
  amountCents Int
  currency    String
  credits     Int
  sourceId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  price       Price?   @relation(fields: [priceId], references: [id], onDelete: SetNull)

  @@unique([siteId, customerId, sourceId])
  @@index([siteId, customerId, createdAt])
  @@index([siteId, priceId])
  @@index([siteId, createdAt])
  @@index([siteId, status])
  @@index([siteId, status, createdAt])
}

model PaymentEvent {
  id              String    @id
  siteId          String
  provider        String
  providerEventId String
  eventType       String
  processedAt     DateTime?
  payload         Json
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, provider, providerEventId])
  @@index([siteId, eventType])
  @@index([siteId, processedAt])
  @@index([processedAt])
}

model CreditLedger {
  id         String    @id
  siteId     String
  customerId String
  amount     Int
  type       String
  sourceType String
  sourceId   String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([siteId, customerId, type, sourceId])
  @@index([siteId, customerId, createdAt])
  @@index([siteId, sourceType, sourceId])
  @@index([siteId, createdAt])
  @@index([siteId, type, createdAt])
}

model CreditBalance {
  id         String   @id
  siteId     String
  customerId String   @unique
  balance    Int      @default(0)
  reserved   Int      @default(0)
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([siteId, customerId])
  @@index([siteId])
}

model AiApp {
  id              String          @id
  slug            String          @unique
  name            String
  description     String
  appType         String
  parameterSchema Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  sites           SiteAiApp[]
  jobs            GenerationJob[]

  @@index([appType])
}

model SiteAiApp {
  id             String   @id
  siteId         String
  aiAppId        String
  enabled        Boolean  @default(true)
  creditCost     Int
  routeKey       String
  workflowConfig Json?
  providerConfig Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  site           Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  aiApp          AiApp    @relation(fields: [aiAppId], references: [id], onDelete: Cascade)

  @@unique([siteId, aiAppId])
  @@unique([siteId, routeKey])
  @@index([siteId, enabled])
  @@index([siteId, enabled, routeKey])
}

model SiteApiKey {
  id         String    @id
  siteId     String
  label      String
  keyHash    String    @unique
  keyPreview String
  scopes     String[]  @default([])
  enabled    Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  site       Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, enabled])
  @@index([siteId, createdAt])
}

model ToolCategory {
  id          String         @id
  siteId      String
  parentId    String?
  slug        String
  label       String
  description String?
  icon        String?
  sortOrder   Int            @default(0)
  status      String         @default("active")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  site        Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent      ToolCategory?  @relation("ToolCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    ToolCategory[] @relation("ToolCategoryChildren")
  menuItems   ToolMenuItem[]

  @@unique([siteId, slug])
  @@index([siteId, parentId, sortOrder])
  @@index([siteId, status])
}

model ToolMenuItem {
  id          String        @id
  siteId      String
  categoryId  String?
  slug        String
  title       String
  description String?
  badge       String?
  icon        String?
  imageUrl    String?
  href        String
  detailJson  Json?
  sortOrder   Int           @default(0)
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  site        Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category    ToolCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([siteId, slug])
  @@index([siteId, categoryId, sortOrder])
  @@index([siteId, status])
}

model AiGatewayGroup {
  id                 String   @id
  siteId             String
  name               String
  status             String
  modelAllowlist     String[]
  monthlyQuota       Int
  usedQuota          Int      @default(0)
  retryStatusCodes   Int[]
  rateLimitPerMinute Int
  accountPoolMode    String
  unavailableReason  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, name])
  @@index([siteId, status])
  @@index([siteId, status, name])
}

model ThemePage {
  id            String   @id
  siteId        String
  pageType      String
  templateKey   String?
  slug          String
  title         String
  draftJson     Json
  publishedJson Json
  draftMeta     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId, pageType])
  @@index([siteId, templateKey])
  @@index([siteId, updatedAt])
}

/// Current public page data. Public SSR reads this table directly on every
/// request; there is no draft, publication snapshot, or ThemePage fallback.
model LivePage {
  id          String   @id
  siteId      String
  pageType    String
  templateKey String?
  slug        String
  title       String
  contentJson Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId, pageType])
  @@index([siteId, templateKey])
  @@index([siteId, updatedAt])
}

model ThemeSettings {
  id            String   @id
  siteId        String   @unique
  draftJson     Json
  publishedJson Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model StorefrontProfile {
  id            String   @id
  siteId        String   @unique
  draftJson     Json
  publishedJson Json
  draftMeta     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

/// The sole runtime owner for a site's public storefront projection.
///
/// This model is intentionally one row per site. Historical publication
/// snapshots remain a migration concern only and must not be queried by the
/// public runtime once this model is activated.
model SitePublishedState {
  siteId       String   @id
  payload      Json
  contentHash  String
  revision     String
  publishedAt  DateTime @updatedAt
  publishedBy  String

  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([contentHash])
}

model ThemePublication {
  id            String                  @id
  siteId        String
  version       Int
  snapshot      Json
  pageCount     Int?
  sectionCount  Int?
  snapshotBytes Int?
  scope         Json?
  manifestHash  String?
  factsRevision String?
  approvalId    String?                 @unique
  publishedBy   String
  publishedAt   DateTime                @default(now())
  site          Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  activeFor     ActiveThemePublication?
  approval      ThemePublishApproval?    @relation(fields: [approvalId], references: [id], onDelete: Restrict)

  @@unique([siteId, version])
  @@index([siteId, publishedAt])
  @@index([siteId, version])
  @@index([siteId, factsRevision])
}

model ThemePublishApproval {
  id                   String                     @id
  siteId               String
  requestedBy          String?
  manifestHash         String
  approvedBy           String?
  approvedAt           DateTime?
  expiresAt            DateTime?
  status               String                     @default("pending")
  consumedAt           DateTime?
  consumedPublicationId String?                   @unique
  site                 Site                       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items                ThemePublishApprovalItem[]
  publication          ThemePublication?

  @@index([siteId, status, approvedAt])
  @@index([siteId, manifestHash])
}

model ThemePublishApprovalItem {
  id         String              @id
  approvalId String
  objectType String
  objectId   String
  ownerId    String
  revision   String
  etag       String?
  valueHash  String
  approval   ThemePublishApproval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, objectType, objectId])
  @@index([approvalId, objectType])
}

model ActiveThemePublication {
  siteId        String           @id
  publicationId String           @unique
  activatedAt   DateTime         @default(now())
  activatedBy   String
  site          Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  publication   ThemePublication @relation(fields: [publicationId], references: [id], onDelete: Restrict)

  @@index([publicationId])
}

model SiteTheme {
  id        String   @id
  siteId    String
  name      String
  themeId   String
  themeKey  String
  status    String
  templates Json
  settings  Json
  source    String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, themeId])
  @@index([siteId, status])
  @@index([siteId, status, updatedAt])
  @@index([siteId, themeKey])
}

model ThemeCopy {
  id        String   @id
  siteId    String
  name      String
  themeKey  String
  source    String
  templates Json
  settings  Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, themeKey])
  @@index([siteId, createdAt])
  @@index([siteId, updatedAt])
}

model SectionDefinition {
  id          String @id
  type        String @unique
  label       String
  category    String
  schemaJson  Json
  previewJson Json
}

model MediaAsset {
  id         String   @id
  siteId     String
  label      String
  storageKey String
  mimeType   String
  usageType  String
  sourceType String?
  previewUrl String?
  originUrl  String?
  altText    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, storageKey])
  @@index([siteId, usageType])
  @@index([siteId, usageType, createdAt])
  @@index([siteId, createdAt])
}

model CreativePack {
  id               String                @id
  siteId           String
  categoryId       String?
  name             String
  headline         String
  description      String
  prompt           String?
  category         String
  aiAppSlug        String
  status           String
  creditCost       Int
  outputCount      Int
  trainingRequired Boolean               @default(false)
  generationCount  Int                   @default(0)
  conversionRate   Float                 @default(0)
  imageUrl         String?
  galleryImages    Json?
  galleryImageAlts Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  site             Site                  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  categoryRecord   CreativePackCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  albums           Album[]

  @@index([siteId, status])
  @@index([siteId, category])
  @@index([siteId, categoryId])
  @@index([siteId, aiAppSlug])
  @@index([siteId, status, createdAt])
}

model CreativePackCategory {
  id           String                 @id
  siteId       String
  parentId     String?
  slug         String
  label        String
  description  String?
  heroTitle    String?
  heroSubtitle String?
  icon         String?
  imageUrl     String?
  sortOrder    Int                    @default(0)
  status       String                 @default("active")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  site         Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent       CreativePackCategory?  @relation("CreativePackCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     CreativePackCategory[] @relation("CreativePackCategoryChildren")
  packs        CreativePack[]

  @@unique([siteId, slug])
  @@index([siteId, parentId, sortOrder])
  @@index([siteId, status])
}

model VideoTheme {
  id              String                   @id
  siteId          String
  categoryId      String?
  slug            String
  name            String
  headline        String
  description     String
  prompt          String
  status          String                   @default("draft")
  creditCost      Int
  modelPricing    Json?
  durationSeconds Int                      @default(6)
  maxFrames       Int                      @default(30)
  generationCount Int                      @default(0)
  sortOrder       Int                      @default(0)
  imageUrl        String?
  galleryImages   Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  site            Site                     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category        VideoThemeCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  examples        VideoThemeExample[]
  slugRedirects   VideoThemeSlugRedirect[]

  @@unique([siteId, slug])
  @@index([siteId, status, sortOrder])
  @@index([siteId, categoryId])
  @@index([siteId, status, createdAt])
}

model VideoThemeExample {
  id            String     @id
  siteId        String
  themeId       String
  name          String
  description   String?
  imageUrl      String?
  galleryImages Json?
  prompt        String
  status        String     @default("draft")
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  site          Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  theme         VideoTheme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([siteId, themeId, status, sortOrder])
  @@index([siteId, status, createdAt])
}

model VideoThemeCategory {
  id          String               @id
  siteId      String
  parentId    String?
  slug        String
  label       String
  description String?
  icon        String?
  accentColor String?
  imageUrl    String?
  sortOrder   Int                  @default(0)
  status      String               @default("active")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  site        Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  parent      VideoThemeCategory?  @relation("VideoThemeCategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    VideoThemeCategory[] @relation("VideoThemeCategoryChildren")
  themes      VideoTheme[]

  @@unique([siteId, slug])
  @@index([siteId, sortOrder])
  @@index([siteId, parentId, sortOrder])
  @@index([siteId, status])
}

model VideoThemeSlugRedirect {
  id        String      @id
  siteId    String
  themeId   String?
  oldSlug   String
  createdAt DateTime    @default(now())
  site      Site        @relation(fields: [siteId], references: [id], onDelete: Cascade)
  theme     VideoTheme? @relation(fields: [themeId], references: [id], onDelete: SetNull)

  @@unique([siteId, oldSlug])
  @@index([siteId, themeId])
}

model CustomerModel {
  id              String        @id
  siteId          String
  customerId      String
  label           String
  modelType       String
  status          String
  inputAssetCount Int
  minInputAssets  Int
  providerModelId String?
  trainingJobId   String?
  failureReason   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploads         AssetUpload[]

  @@index([siteId, customerId, status])
  @@index([siteId, providerModelId])
  @@index([siteId, createdAt])
  @@index([siteId, status, updatedAt])
  @@index([siteId, updatedAt])
}

model Album {
  id             String                  @id
  siteId         String
  customerId     String
  title          String
  sourceJobId    String?
  creativePackId String?
  status         String
  outputCount    Int
  coverAssetId   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  site           Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer       Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceJob      GenerationJob?          @relation(fields: [sourceJobId], references: [id])
  creativePack   CreativePack?           @relation(fields: [creativePackId], references: [id])
  coverAsset     AssetUpload?            @relation("AlbumCoverAsset", fields: [coverAssetId], references: [id])
  downloads      CustomerAssetDownload[]

  @@index([siteId, customerId, status])
  @@index([siteId, customerId, updatedAt])
  @@index([siteId, sourceJobId])
  @@index([siteId, creativePackId])
  @@index([siteId, createdAt])
  @@index([siteId, status, updatedAt])
  @@index([siteId, updatedAt])
}

model AssetUpload {
  id               String                  @id
  siteId           String
  customerId       String
  customerModelId  String?
  subjectRole      String?
  jobId            String?
  label            String
  storageKey       String
  mimeType         String
  role             String
  visibility       String
  reviewStatus     String
  validationStatus String?
  validationReport Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?
  site             Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer         Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerModel    CustomerModel?          @relation(fields: [customerModelId], references: [id])
  job              GenerationJob?          @relation(fields: [jobId], references: [id])
  albumCovers      Album[]                 @relation("AlbumCoverAsset")
  profileAvatars   CustomerProfile[]       @relation("CustomerProfileAvatarAsset")
  downloads        CustomerAssetDownload[]

  @@index([siteId, storageKey])
  @@index([siteId, customerId, role])
  @@index([siteId, customerModelId])
  @@index([siteId, jobId])
  @@index([siteId, reviewStatus])
  @@index([siteId, reviewStatus, createdAt])
  @@index([siteId, role, deletedAt, createdAt])
  @@index([siteId, customerId, createdAt])
  @@index([siteId, createdAt])
}

model CustomerAssetDownload {
  id         String         @id
  siteId     String
  customerId String
  assetId    String
  jobId      String?
  albumId    String?
  source     String         @default("asset")
  createdAt  DateTime       @default(now())
  site       Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  asset      AssetUpload    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  job        GenerationJob? @relation(fields: [jobId], references: [id])
  album      Album?         @relation(fields: [albumId], references: [id])

  @@index([siteId, customerId, createdAt])
  @@index([siteId, customerId, assetId, createdAt])
  @@index([siteId, assetId])
  @@index([siteId, jobId])
  @@index([siteId, albumId])
}

model PartnerApplication {
  id            String    @id
  siteId        String
  email         String
  name          String
  company       String?
  website       String?
  socialLinks   Json?
  audience      String?
  cadence       String?
  campaignIdeas String?
  message       String?
  status        String    @default("pending")
  source        String?
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, status])
  @@index([siteId, createdAt])
  @@index([siteId, status, createdAt])
  @@index([siteId, email])
}

model GenerationJob {
  id              String                  @id
  siteId          String
  customerId      String
  aiAppId         String
  status          String
  creditsReserved Int
  entryPoint      String                  @default("customer_workspace")
  idempotencyKey  String?
  requestHash     String?
  requestJson     Json
  resultJson      Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  site            Site                    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  customer        Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  aiApp           AiApp                   @relation(fields: [aiAppId], references: [id])
  uploads         AssetUpload[]
  albums          Album[]
  downloads       CustomerAssetDownload[]

  @@unique([siteId, customerId, idempotencyKey])
  @@index([siteId, customerId, createdAt])
  @@index([siteId, customerId, updatedAt])
  @@index([siteId, status])
  @@index([siteId, aiAppId])
  @@index([siteId, entryPoint, createdAt])
  @@index([siteId, idempotencyKey])
  @@index([siteId, createdAt])
  @@index([siteId, status, updatedAt])
  @@index([siteId, updatedAt])
  @@index([status, updatedAt])
}

model AuditLog {
  id         String   @id
  siteId     String?
  actorType  String
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  site       Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([siteId, createdAt])
  @@index([actorType, actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model DeploymentRelease {
  id                String    @id
  releaseId         String
  environment       String
  siteId            String
  codeCommit        String
  manifestHash      String
  schemaMigrations  Json
  contentMigrations Json
  scope             Json
  status            String
  details           Json?
  appliedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([environment, siteId, releaseId])
  @@index([environment, siteId, appliedAt])
  @@index([manifestHash])
}
